# Copy this file to .env and fill in the values. NEVER commit .env.

# Token of the TEST bot (e.g. @EventumHQTestBot) from @BotFather — not the main bot.
BOT_TOKEN= 

# Numeric Telegram ID of the OWNER (get it from @userinfobot). Required.
OWNER_TELEGRAM_ID= 

# Team group and private archive channel IDs (needed from M2/M5; can stay empty in M0).
TEAM_GROUP_ID=
ARCHIVE_CHANNEL_ID=

DATABASE_URL=sqlite+aiosqlite:///data/eventum.db

# Only for local development in Iran, e.g. socks5://127.0.0.1:10808
# Leave empty on the server or if your VPN is in TUN/system mode.
# Inside Docker Desktop on Windows use socks5://host.docker.internal:10808
TELEGRAM_PROXY=

LOG_LEVEL=INFO
